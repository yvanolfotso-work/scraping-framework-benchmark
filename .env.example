# Provider : groq | anthropic | openai
LLM_PROVIDER=groq

# Clés (ne mets que celles dont tu as besoin)
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Modèles (optionnels – des valeurs par défaut raisonnables sont dans le code)
GROQ_MODEL=llama-3.3-70b-versatile
# ou openai/gpt-oss-120b si tu l’utilises encore
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o-mini