# ----------------------------------------------------------------------
# Copie ce fichier en .env et remplis les valeurs.
# .env ne doit JAMAIS etre commite.
# ----------------------------------------------------------------------

# Dossier contenant artistes.json et catalogue.json produits par le scraper.
# Par defaut : le dossier parent du projet d'augmentation.
SCRAPING_DIR=C:\Users\jojo\Documents\projetcts\Professionnelle_fig\Test Scraping\Scrapling_demos_clients

# sur notre vps
# SCRAPING_DIR=/home/bartoux/apps/scraping-framework-benchmark/Scrapling_demos_clients

# Google Programmable Search (API officielle, pas de scraping de Google).
# 1. Cle API      : https://console.cloud.google.com/apis/credentials
#    -> activer "Custom Search API"
# 2. Moteur + CX  : https://programmablesearchengine.google.com/
#    -> creer un moteur, activer "Rechercher sur l'ensemble du Web",
#       puis copier l'ID du moteur de recherche
# Quota gratuit : 100 requetes/jour.
# Si ces deux variables sont absentes, le fournisseur google_cse est
# simplement ignore et seul Wikipedia est interroge.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=